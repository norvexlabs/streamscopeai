[
  {"id": "ASI02-01b", "title": "Sensitive credential file access", "description": "[ASI02] Reads or writes of /etc/passwd, /etc/shadow, /etc/sudoers, /etc/gshadow and similar credential files via any file tool — credential disclosure / privilege escalation",
    "risk": "danger", "phase": "response", "scope": "tool_calls", "priority": 10,
    "match": [
      {"target": "tool_id", "op": "in", "value": ["read_file", "list_files", "search_files", "write_file", "edit_file", "delete_file", "move_file", "notebook_edit"]},
      {"target": "arg.path", "op": "glob", "value": "/etc/shadow*|/etc/gshadow*|/etc/passwd*|/etc/sudoers|/etc/sudoers.d/*|/etc/master.passwd*|/etc/security/opasswd*"}
    ],
    "action": {"kind": "block"}, "is_builtin": true, "framework_refs": ["OWASP-LLM06", "OWASP-LLM02"]},

  {"id": "ASI05-01b", "title": "Sensitive credential files via shell", "description": "[ASI05] Shell commands touching /etc/passwd, /etc/shadow, /etc/sudoers and similar credential files — credential disclosure / privilege escalation",
    "risk": "danger", "phase": "response", "scope": "tool_calls", "priority": 10,
    "match": [
      {"target": "tool_id", "op": "equals", "value": "shell_exec"},
      {"target": "arg.command", "op": "contains_any", "value": ["/etc/shadow", "/etc/gshadow", "/etc/passwd", "/etc/sudoers", "/etc/master.passwd", "/etc/security/opasswd"]}
    ],
    "action": {"kind": "block"}, "is_builtin": true, "framework_refs": ["OWASP-LLM06", "OWASP-LLM02"]},

  {"id": "ASI02-01", "title": "System file reads", "description": "[ASI02] Reads of /etc, /proc, /sys via any read tool — credential and config disclosure",
