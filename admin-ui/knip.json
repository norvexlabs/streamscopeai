{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/routes/**/+{page,layout,error}.svelte",
    "src/routes/**/+{page,layout,page.server,layout.server,server}.ts",
    "src/hooks.{client,server}.ts",
    "vite.config.{js,ts}",
    "src/**/*.test.ts",
    "vitest.config.{js,ts}"
  ],
  "project": [
    "src/**/*.{ts,svelte}"
  ],
  "ignore": [
    "src/lib/generated/**"
  ]
}
