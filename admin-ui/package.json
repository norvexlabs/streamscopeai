{
  "name": "streamscope-admin-ui",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite dev",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale",
    "check": "npm run paraglide && svelte-kit sync && svelte-check --threshold warning --fail-on-warnings",
    "build": "vite build",
    "preview": "vite preview",
    "generate-api": "openapi-typescript ../docs/openapi.json -o src/lib/generated/api-types.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@inlang/paraglide-js": "^2.29.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "knip": "^6.42.1",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "highlight.js": "^11.12.0",
    "layercake": "^11.0.0",
    "openapi-fetch": "^0.17.0"
  },
  "type": "module",
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
